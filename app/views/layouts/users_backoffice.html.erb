<!DOCTYPE html>
<html>
<head>
  <title>LfAutoCenter</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  <%= javascript_include_tag 'adminlte/dist/js/adminlte.min.js' %>
</head>

<body class="hold-transition sidebar-mini layout-fixed">
  <!-- Site wrapper -->
  <div class="wrapper">
    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
      <!-- Left navbar links -->
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item d-none d-sm-inline-block">
            <%= link_to 'Sair', destroy_user_session_path, method: :delete, class: "nav-link" %>
          </li>
        <% else %>
          <li class="nav-item d-none d-sm-inline-block">
           <%= link_to 'Entrar', users_backoffice_welcome_index_path, class: "nav-link" %>
          </li>
          <li class="nav-item d-none d-sm-inline-block">
           <%= link_to 'Cadastre-se', new_user_registration_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
       

      <!-- Right navbar links -->
      <ul class="navbar-nav ml-auto">
        <!-- Navbar Search -->
        <li class="nav-item">
          <a class="nav-link" data-widget="navbar-search" href="#" role="button">
            <i class="fas fa-search"></i>
          </a>
          <div class="navbar-search-block">
            <form class="form-inline">
              <div class="input-group input-group-sm">
                <input class="form-control form-control-navbar" type="search" placeholder="Search" aria-label="Search">
                <div class="input-group-append">
                  <button class="btn btn-navbar" type="submit">
                    <i class="fas fa-search"></i>
                  </button>
                  <button class="btn btn-navbar" type="button" data-widget="navbar-search">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </li>

    <!-- Main Sidebar Container -->
    <aside class="main-sidebar main-sidebar-custom sidebar-dark-primary elevation-4">
      
      <!-- Brand Logo -->
      <a href="/" class="brand-link">
        <img src="<%= asset_path 'AdminLTELogo.png' %>" alt="AdminLTE Logo" class="brand-image img-circle elevation-3 " style="opacity: .8">
        <span class="brand-text font-weight-light">LF Auto center</span>
      </a>

      <!-- Sidebar user (optional) -->
      <div class="user-panel mt-3 pb-3 mb-3 d-flex">
        <div class="image">
          <img src="<%= asset_path 'user2-160x160.jpg' %>" class="img-circle elevation-2" alt="User Image">
        </div>
        <div class="info">
          <a href="#" class="d-block"><%= current_user.user_name %></a>
        </div>
      </div>
  
      <!-- Sidebar Menu -->
      <div class="sidebar">
        <nav class="mt-2">
          <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
            <!-- Add icons to the links using the .nav-icon class
                 with font-awesome or any other icon font library -->
            <li class="nav-item">
              <a href="#" class="nav-link">
                <i class="nav-icon fas fa-tachometer-alt"></i>
                <p>
                  Veiculos
                  <i class="right fas fa-angle-left"></i>
                </p>
              </a>
              <ul class="nav nav-treeview">
                <li class="nav-item">
                  <a href="<%= new_users_backoffice_vehicle_path %>" class="nav-link">
                    <i class="far fa-circle nav-icon"></i>
                    <p>Cadastrar Veiculos</p>
                  </a>
                </li>
                <li class="nav-item">
                  <a href="<%= users_backoffice_vehicles_path %>" class="nav-link">
                    <i class="far fa-circle nav-icon"></i>
                    <p>Consultar Veiculos</p>
                  </a>
                </li>
              </ul>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                  <i class="far fa-circle nav-icon"></i>
                  <p>Clientes</p>
                </a>
                <ul class="nav nav-treeview">
                <li class="nav-item">
                  <a href="<%= new_users_backoffice_client_path %>" class="nav-link">
                    <i class="far fa-circle nav-icon"></i>
                    <p>Cadastrar clientes</p>
                  </a>
                </li>
                <li class="nav-item">
                  <a href="<%= users_backoffice_clients_path %>" class="nav-link">
                    <i class="far fa-circle nav-icon"></i>
                    <p>Consultar clientes</p>
                  </a>
                </li>
              </ul>
              </li>
          </ul>
        </nav>
      </div>
      <!-- /.sidebar-menu -->
    </aside>
    
    <!-- /.sidebar-custom -->
  </div>
  <!-- /.wrapper -->

  <!-- Content Wrapper. Contains page content -->
  
  <div class="content-wrapper">
   
    <!-- Main content -->
    <section class="content">
     <%= yield %>
    </section>
  </div>
  <!-- /.content-wrapper -->

  <footer class="main-footer">
    <div class="float-right d-none d-sm-block">
      <b>Version</b> 3.2.0
    </div>
    <strong>Copyright &copy; 2014-2021 <a href="https://adminlte.io">AdminLTE.io</a>.</strong>
    All rights reserved.
  </footer>

  <!-- Control Sidebar -->
  <aside class="control-sidebar control-sidebar-dark">
    <!-- Control sidebar content goes here -->
  </aside>
  <!-- /.control-sidebar -->
</body>
</html>
