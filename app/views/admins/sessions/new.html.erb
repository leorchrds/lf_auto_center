<% flash.each do |key, value| %>
  <div class="flash <%= key %>"><%= value %></div>
<% end %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'login-form'})  do |f| %>
  <div class="form-group">
    <%= f.label :email %><br />
    <%= f.email_field :email, required: false, autofocus: true, autocomplete: "email", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :password %><br />
    <%= f.password_field :password, required: false, autocomplete: "current-password", class: "form-control" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="form-group form-check">
      <%= f.check_box :remember_me, class: 'form-check-input remember' %>
      <%= f.label :remember_me, class: 'form-check-label' %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.submit "Log in", class: 'btn btn-primary rounded btn-block' %>
  </div>
<% end %>

<%= render "admins/shared/links" %>
