<h1><%=t('messages.listing', model: @users.model_name.human(count: 2))%></h1>

<table class="table">
  <thead>
    <tr>
      <th>Id</th>
      <th>Email</th>
      <th>Usuário</th>
    </tr>
  </thead>
  <tbody>

  <% @users.each do |user| %>
    <tr>
      <td><%=user.id %></td>
      <td><%=user.email%> </td>
      <td><%=user.user_name%> </td>
    </tr>
  <% end %> 
    </tr>
  </tbody>
</table>
