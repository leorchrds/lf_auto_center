<% if notice.present? %>
  <div class="alert alert-success alert-dismissible">
    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
    <h5><i class="icon fas fa-check"></i> <%= notice %></h5>
  </div>
<% end %>

<p>
  <strong>Cliente:</strong>
  <%= @service_order.client.name %>
</p>

<p>
  <strong>Veiculo:</strong>
  <%= @service_order.vehicle.brand %>
  <%= @service_order.vehicle.model %>
</p>

<p>
  <strong>Km:</strong>
  <%= @service_order.mileage %>
</p>

<p>
  <strong>Data de entrada:</strong>
  <%= @service_order.entry_date %>
</p>

<p>
  <strong>Data de saída:</strong>
  <%= @service_order.exit_date %>
</p>

<p>
  <strong>Descrição do serviço:</strong>
  <%= @service_order.description %>
</p>

<%= link_to 'Voltar', users_backoffice_service_orders_path, class:"btn btn-primary" %>

