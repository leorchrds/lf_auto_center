<div class="content-wrapper" style="min-height: 502.334px;">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="row justify-content-center">
          <div class="col-sm-12">
            <div class="card card-primary">
              <div class="card-header">
                <h3 class="card-title">Nova Ordem de Serviço</h3>
              </div>

              <%= simple_form_for([:users_backoffice, @service_order], html: { class: "form-horizontal"  }) do |f| %>
                <%= f.error_notification %>
                <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
                  
                <div class="card-body">
                  <div class="form-group row">
                    <div class="col-sm-3">
                      <%= label_tag :vehicle_model_filter, "Filtrar modelos de veículos:", class: "control-label text-right" %>
                    </div>
                    <div class="col-sm-9">
                      <%= text_field_tag :vehicle_model_filter, params[:vehicle_model_filter], class: "form-control", id: "vehicle_model_filter", placeholder: "Digite para filtrar os modelos de veículos" %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <div class="col-sm-3">
                      <%= label_tag :vehicle_model, "Modelo do veículo:", class: "control-label text-right" %>
                    </div>
                    <div class="col-sm-9">
                      <%= select_tag :vehicle_model, options_for_select(Vehicle.pluck(:model).uniq.sort, params[:vehicle_model]), include_blank: true, class: "form-control", id: "vehicle_model_select" %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <div class="col-sm-3">
                      <%= label_tag :client, "Selecione o cliente:", class: "control-label text-right" %>
                    </div>
                    <div class="col-sm-9">
                      <%= f.association :client, label: false, include_blank: false, class: "form-control#{' is-invalid' if f.object.errors[:client].present?}" %>
                      <% if f.object.errors[:client].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:client].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                  

                <div class="card-body">
                  <div class="form-group row">
                    <%= f.label :mileage, "Quilometragem do Veículo", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.number_field :mileage, class: "form-control#{' is-invalid' if f.object.errors[:mileage].present?}", placeholder: "Quilometragem do Veículo" %>
                      <% if f.object.errors[:mileage].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:mileage].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>


                  <div class="form-group row">
                    <%= f.label :entry_date, "Data de Entrada", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.date_field :entry_date, class: "form-control#{' is-invalid' if f.object.errors[:entry_date].present?}" %>
                      <% if f.object.errors[:entry_date].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:entry_date].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :exit_date, "Data de Saída", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.date_field :exit_date, class: "form-control#{' is-invalid' if f.object.errors[:exit_date].present?}" %>
                      <% if f.object.errors[:exit_date].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:exit_date].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :description, "Descrição do Serviço", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.text_area :description, class: "form-control#{' is-invalid' if f.object.errors[:description].present?}", placeholder: "Descrição do Serviço", rows: 5 %>
                      <% if f.object.errors[:description].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:description].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-footer">
                <%= f.submit "Salvar", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const vehicleModelFilter = document.getElementById('vehicle_model_filter');
    const vehicleModelSelect = document.getElementById('vehicle_model_select');
    const allOptions = Array.from(vehicleModelSelect.options); // Armazena todas as opções inicialmente

    function filterOptions() {
      const filterValue = vehicleModelFilter.value.trim().toLowerCase(); // Removemos espaços em branco extras e colocamos em minúsculas
      vehicleModelSelect.innerHTML = ''; // Limpa as opções atuais

      // Filtra e adiciona as opções correspondentes
      allOptions.forEach(function(option) {
        if (option.value.trim().toLowerCase().includes(filterValue) || filterValue === '') { // Verifica se o valor da opção inclui o filtro ou se o filtro está vazio
          vehicleModelSelect.appendChild(option.cloneNode(true));
        }
      });
    }

    // Adiciona ouvintes de eventos para os eventos input, change, blur e focus
    vehicleModelFilter.addEventListener('input', filterOptions);
    vehicleModelFilter.addEventListener('change', filterOptions);
    vehicleModelFilter.addEventListener('blur', filterOptions);
    vehicleModelFilter.addEventListener('focus', filterOptions);
  });
</script>
