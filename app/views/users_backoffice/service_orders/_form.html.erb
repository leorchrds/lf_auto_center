<div class="content-wrapper" style="min-height: 502.334px;">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="row justify-content-center">
          <div class="col-sm-12">
            <div class="card card-primary">
              <div class="card-header">
                <h3 class="card-title">Nova Ordem de Serviço</h3>
              </div>

              <%= simple_form_for([:users_backoffice, @service_order], html: { class: "form-horizontal" }) do |f| %>
                <%= f.error_notification %>
                <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
                  
                <div class="card-body">
                  <div class="form-group row">
                    <div class="col-sm-3">
                      <%= label_tag :client, "Selecione o cliente:", class: "control-label text-right" %>
                    </div>
                    <div class="col-sm-6">
                          <%= f.association :client, label: false, include_blank: false, class: "form-control#{' is-invalid' if f.object.errors[:client].present?}", id: "client_select" %>                      <% if f.object.errors[:client].present? %>
                          <div class="invalid-feedback">
                              <%= f.object.errors[:client].to_sentence %>
                          </div>
                      <% end %>
                    </div>
                    <div class="col-sm-3">
                      <%= link_to new_users_backoffice_client_path, class: "btn btn-info" do %>
                        <i class="fas fa-plus"></i> Cliente
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <div class="col-sm-3">
                      <%= label_tag :vehicle_model, "Modelo do veículo:", class: "control-label text-right" %>
                    </div>
                    <div class="col-sm-6">
                      <%= f.select :vehicle_id, [], { prompt: "Selecione um veículo" }, class: "form-control", id: "vehicle_select" %>
                    </div>
                    <div class="col-sm-3"> 
                      <%= link_to new_users_backoffice_vehicle_path, class: "btn btn-info" do %>
                        <i class="fas fa-plus"></i> Veículo
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :mileage, "Quilometragem do Veículo", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.number_field :mileage, class: "form-control#{' is-invalid' if f.object.errors[:mileage].present?}", placeholder: "Quilometragem do Veículo" %>
                      <% if f.object.errors[:mileage].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:mileage].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :entry_date, "Data de Entrada", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.date_field :entry_date, class: "form-control#{' is-invalid' if f.object.errors[:entry_date].present?}" %>
                      <% if f.object.errors[:entry_date].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:entry_date].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :exit_date, "Data de Saída", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.date_field :exit_date, class: "form-control#{' is-invalid' if f.object.errors[:exit_date].present?}" %>
                      <% if f.object.errors[:exit_date].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:exit_date].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :description, "Descrição do Serviço", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.text_area :description, class: "form-control#{' is-invalid' if f.object.errors[:description].present?}", placeholder: "Descrição do Serviço", rows: 5 %>
                      <% if f.object.errors[:description].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:description].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :service_value, "Valor do Serviço", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.number_field :service_value, step: :any, class: "form-control#{' is-invalid' if f.object.errors[:service_value].present?}", placeholder: "Valor do Serviço" %>
                      <% if f.object.errors[:service_value].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:service_value].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="form-group row">
                    <%= f.label :payment_method, "Forma de Pagamento", class: "col-sm-3 control-label" %>
                    <div class="col-sm-9">
                      <%= f.select :payment_method, options_for_select(['Pix', 'Cartão de Crédito', 'Débito', 'Dinheiro'], include_blank: true), {}, class: "form-control#{' is-invalid' if f.object.errors[:payment_method].present?}" %>
                      <% if f.object.errors[:payment_method].present? %>
                        <div class="invalid-feedback">
                          <%= f.object.errors[:payment_method].to_sentence %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="card-footer">
                    <%= f.submit "Salvar", class: "btn btn-primary" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
  const clientSelect = document.getElementById('service_order_client_id');
  const vehicleSelect = document.getElementById('vehicle_select');

  if (!clientSelect) {
    console.error('Elemento com ID "client_select" não encontrado.');
    return;
  }
  
  if (!vehicleSelect) {
    console.error('Elemento com ID "vehicle_select" não encontrado.');
    return;
  }

  clientSelect.addEventListener('change', function() {
    const clientId = this.value;

    if (clientId) {
      vehicleSelect.innerHTML = '<option value="">Carregando...</option>';
      fetch(`/users_backoffice/vehicles/by_cliente?client_id=${clientId}`)
        .then(response => response.json())
        .then(data => {
          console.log('Dados recebidos:', data); // Adicione esta linha
          vehicleSelect.innerHTML = '<option value="">Selecione um veículo</option>';

          data.forEach(function(vehicle) {
            console.log('Veículo:', vehicle); // Adicione esta linha
            const option = document.createElement('option');
            option.value = vehicle.id;
            option.text = vehicle.model;
            vehicleSelect.appendChild(option);
          });
        })
        .catch(error => {
          vehicleSelect.innerHTML = '<option value="">Erro ao carregar veículos</option>';
          console.error('Erro ao buscar veículos:', error);
        });
    } else {
      vehicleSelect.innerHTML = '<option value="">Selecione um veículo</option>';
    }
  });
});

</script>
