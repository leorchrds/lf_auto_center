<p id="notice"><%= notice %></p>

<p>
  <strong>Cliente:</strong>
  <%= @budget.client.name.upcase %>
</p>

<p>

<h5>Descrição de serviços:</h5>
<table>
  <thead>
    <tr>
      <th>Serviço</th>
      <th>Quantidade</th>
      <th>Valor Unitário</th>
      <th>Total</th>
    </tr>
  </thead>
<tbody>
  <% total_price = 0 %>
  <% @budget.budget_line_items.each do |budget_line_item| %>
    <tr>
      <td><%= budget_line_item.service_name %></td>
      <td><%= budget_line_item.quantity %></td>
      <td><%= number_to_currency(budget_line_item.unit_price) %></td>
      <% if budget_line_item.quantity && budget_line_item.unit_price %>
          <% item_total = budget_line_item.quantity * budget_line_item.unit_price %>
          <td><%= number_to_currency(item_total) %></td>
        <% else %>
          <td>N/A</td>
        <% end %>
    </tr>
    <% total_price += item_total %>
  <% end %>
  <tr>
    <td colspan="3"><strong>Total:</strong></td>
    <td><strong><%= number_to_currency(total_price) %></strong></td>
  </tr>
</tbody>

</table>

<%= link_to 'Voltar', users_backoffice_budgets_path, class:"btn btn-primary" %>
<%= link_to 'Gerar PDF', generate_pdf_users_backoffice_budget_path(@budget, format: :pdf), class:"btn btn-primary" %>
