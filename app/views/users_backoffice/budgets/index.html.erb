<p id="notice"><%= notice %></p>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Orçamentos</h3>

        <div class="card-tools">
          <div class="input-group input-group-sm" style="width: 150px;">
            <input type="text" name="table_search" class="form-control float-right" placeholder="Pesquisar">

            <div class="input-group-append">
              <button type="submit" class="btn btn-default">
                <i class="fas fa-search"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
      <!-- /.card-header -->
      <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
          <thead>
            <tr>
              <th>Cliente</th>
              <th>Total</th>
              <th>Ações</th>
            </tr>
          </thead>
         <tbody>
  <% @budgets.each do |budget| %>
    <tr>
      <td><%= budget.client.name.upcase %></td>
      <td>
        <% budget.budget_line_items.each do |budget_line_item| %>
          <p>
            <strong>Serviço:</strong> <%= budget_line_item.service_name %><br>
            <strong>Quantidade:</strong> <%= budget_line_item.quantity %><br>
            <strong>Preço Unitário:</strong> <%= number_to_currency(budget_line_item.unit_price) %>
          </p>
        <% end %>
      </td>
      <td>
        <%= link_to 'Detalhes', users_backoffice_budget_path(budget), class:"btn btn-primary" %>
        <%= link_to 'Editar', edit_users_backoffice_budget_path(budget), class:"btn btn-primary" %>
        <%= link_to 'Excluir', users_backoffice_budget_path(budget), method: :delete, class:"btn btn-danger", data: { confirm: 'Deseja realmente excluir este orçamento ?'} %>
      </td>
    </tr>
  <% end %>
</tbody>


        </table>
      </div>
      <!-- /.card-body -->
      <div class="card-footer">
        <%= link_to 'Criar novo orçamento', new_users_backoffice_budget_path, class: "btn btn-success" %>
      </div>
    </div>
    <!-- /.card -->
  </div>
</div>
