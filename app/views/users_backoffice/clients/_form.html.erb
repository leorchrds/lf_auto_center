<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
<script>
  $(document).ready(function() {
    // Mask and restrict to numbers only in the phone field
    $('#client_phone').mask('(00) 00000-0000', { placeholder: "(00) 00000-0000" });
    $('#client_phone').on('input', function() {
      this.value = this.value.replace(/\D/g,'');
    });

    // Request to CEP API when leaving the CEP field
    $('#client_address_attributes_postal_code').on('blur', function() {
      var cep = $(this).val().replace(/\D/g, '');
      if (cep.length != 8) {
        return;
      }
      
      $.getJSON('https://viacep.com.br/ws/' + cep + '/json/', function(data) {
        if (!("erro" in data)) {
          $('#client_address_attributes_street').val(data.logradouro);
          $('#client_address_attributes_neighborhood').val(data.bairro);
          $('#client_address_attributes_city').val(data.localidade);
          $('#client_address_attributes_state').val(data.uf);
          $('#client_address_attributes_country').val('Brasil');
        }
      });
    });
  });
</script>

<div class="content-wrapper" style="min-height: 502.334px;">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title">New Client</h3>
            </div>

            <%= simple_form_for([:users_backoffice, @client]) do |f| %>
              <%= f.error_notification %>
              <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
              <div class="card-body">
                <div class="form-group">
                  <%= f.label :name, "Name" %>
                  <%= f.text_field :name, class: "form-control#{' is-invalid' if f.object.errors[:name].present?}", placeholder: "Enter name" %>
                  <% if f.object.errors[:name].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:name].to_sentence %>
                    </div>
                  <% end %>
                </div>
                <div class="form-group">
                  <%= f.label :phone, "Phone" %>
                  <%= f.text_field :phone, class: "form-control#{' is-invalid' if f.object.errors[:phone].present?}", placeholder: "(00) 00000-0000", id: "client_phone" %>
                  <% if f.object.errors[:phone].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:phone].to_sentence %>
                    </div>
                  <% end %>
                </div>
                <div class="form-group">
                  <%= f.label :observation, "Observation" %>
                  <%= f.text_field :observation, class: "form-control", placeholder: "Observation" %>
                </div>
                <div class="form-group">
                  <%= f.fields_for :address do |address_fields| %>
                    <%= address_fields.label :street, "Street" %>
                    <%= address_fields.text_field :street, class: "form-control" %>
                    
                    <%= address_fields.label :number, "Number" %>
                    <%= address_fields.text_field :number, class: "form-control" %>
                    
                    <%= address_fields.label :complement, "Complement" %>
                    <%= address_fields.text_field :complement, class: "form-control" %>
                    
                    <%= address_fields.label :neighborhood, "Neighborhood" %>
                    <%= address_fields.text_field :neighborhood, class: "form-control" %>
                    
                    <%= address_fields.label :city, "City" %>
                    <%= address_fields.text_field :city, class: "form-control" %>
                    
                    <%= address_fields.label :state, "State" %>
                    <%= address_fields.text_field :state, class: "form-control" %>
                    
                    <%= address_fields.label :postal_code, "Postal Code" %>
                    <%= address_fields.text_field :postal_code, class: "form-control" %>
                    
                    <%= address_fields.label :country, "Country" %>
                    <%= address_fields.text_field :country, class: "form-control" %>
                  <% end %>
                </div>
              </div>
              
              <div class="card-footer">
                <%= f.submit "Submit", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
