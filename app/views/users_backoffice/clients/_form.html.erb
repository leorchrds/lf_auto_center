<div class="content-wrapper" style="min-height: 502.334px;">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title">Novo cliente</h3>
            </div>

            <%= simple_form_for([:users_backoffice, @client]) do |f| %>
              <%= f.error_notification %>
              <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
              <div class="card-body">
                <div class="form-group">
                  <%= f.label :name, "Nome" %>
                  <%= f.text_field :name, class: "form-control#{' is-invalid' if f.object.errors[:name].present?}", placeholder: "Enter name" %>
                  <% if f.object.errors[:name].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:name].to_sentence %>
                    </div>
                  <% end %>
                </div>
                <div class="form-group">
                  <%= f.label :phone, "Telefone" %>
                  <%= f.text_field :phone, class: "form-control#{' is-invalid' if f.object.errors[:phone].present?}", placeholder: "Telefone" %>
                  <% if f.object.errors[:phone].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:phone].to_sentence %>
                    </div>
                  <% end %>
                </div>
                <div class="form-group">
                  <%= f.label :address, "Endereço" %>
                  <%= f.text_field :address, class: "form-control#{' is-invalid' if f.object.errors[:address].present?}", placeholder: "Endereço" %>
                  <% if f.object.errors[:address].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:address].to_sentence %>
                    </div>
                  <% end %>
                </div>
                <div class="form-group">
                  <%= f.label :observation, "Observação" %>
                  <%= f.text_field :observation, class: "form-control", placeholder: "Observação" %>
                </div>
              </div>
              <div class="card-footer">
                <%= f.submit "Submit", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
