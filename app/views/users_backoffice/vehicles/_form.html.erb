<div class="content-wrapper" style="min-height: 502.334px;">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title">Novo Veiculo</h3>
            </div>

            <%= simple_form_for([:users_backoffice, @vehicle]) do |f| %>

              <div class="card-body">    
                <div class="form-group">
                  <%= f.label :client_id, "Cliente" %>
                  <%= f.collection_select :client_id, Client.all, :id, :name, { prompt: "Selecione um cliente" }, class: "form-control#{' is-invalid' if f.object.errors[:client_id].present?}" %>

                  <% if f.object.errors[:client_id].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:client_id].to_sentence %>
                    </div>
                  <% end %>
                </div>

                <div class="form-group">
                  <%= f.label :license_plate, "Placa" %>
                  <%= f.text_field :license_plate, class: "form-control#{' is-invalid' if f.object.errors[:license_plate].present?}", placeholder: "Placa" %>
                  
                  <% if f.object.errors[:license_plate].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:license_plate].to_sentence %>
                    </div>
                  <% end %>
                </div>

                <div class="form-group">
                  <%= f.label :brand, "Marca" %>
                  <%= f.text_field :brand, class: "form-control#{' is-invalid' if f.object.errors[:brand].present?}", placeholder: "Marca" %>

                  <% if f.object.errors[:brand].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:brand].to_sentence %>
                    </div>
                  <% end %>
                </div>

                <div class="form-group">
                  <%= f.label :model, "Modelo" %>
                  <%= f.text_field :model, class: "form-control#{' is-invalid' if f.object.errors[:model].present?}", placeholder: "Modelo" %>

                  <% if f.object.errors[:model].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:model].to_sentence %>
                    </div>
                  <% end %>
                </div>

                <div class="form-group">
                  <%= f.label :color, "Cor" %>
                  <%= f.text_field :color, class: "form-control#{' is-invalid' if f.object.errors[:color].present?}", placeholder: "Cor" %>

                  <% if f.object.errors[:color].present? %>
                    <div class="invalid-feedback">
                      <%= f.object.errors[:color].to_sentence %>
                    </div>
                  <% end %>
                </div>

                <div class="form-group">
                  <%= f.label :year_of_manufacture, "Ano de fabricação" %>
                  <%= f.text_field :year_of_manufacture, class: "form-control", placeholder: "Ano de fabricação" %>
                </div>

                <div class="form-group">
                  <%= f.label :fuel_type, "Tipo de combustível" %>
                  <%= f.text_field :fuel_type, class: "form-control", placeholder: "Tipo de combustível" %>
                </div>
              </div>

              <div class="card-footer">
                <%= f.submit "Salvar", class: "btn btn-primary" %>
              </div>

            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
