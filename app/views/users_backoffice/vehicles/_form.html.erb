<div class="content-wrapper" style="min-height: 502.334px;">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title">New Vehicle</h3>
            </div>

            <%= simple_form_for([:users_backoffice, @vehicle]) do |f| %>
              <%= f.error_notification %>
              <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

              <div class="card-body">
                <div class="form-group">
                  <%= f.label :license_plate, "License Plate" %>
                  <%= f.text_field :license_plate, class: "form-control", placeholder: "License Plate" %>
                </div>

                <div class="form-group">
                  <%= f.label :brand, "Brand" %>
                  <%= f.text_field :brand, class: "form-control", placeholder: "Brand" %>
                </div>

                <div class="form-group">
                  <%= f.label :model, "Model" %>
                  <%= f.text_field :model, class: "form-control", placeholder: "Model" %>
                </div>

                <div class="form-group">
                  <%= f.label :color, "Color" %>
                  <%= f.text_field :color, class: "form-control", placeholder: "Color" %>
                </div>

                <div class="form-group">
                  <%= f.label :year_of_manufacture, "Year of Manufacture" %>
                  <%= f.text_field :year_of_manufacture, class: "form-control", placeholder: "Year of Manufacture" %>
                </div>

                <div class="form-group">
                  <%= f.label :fuel_type, "Fuel Type" %>
                  <%= f.text_field :fuel_type, class: "form-control", placeholder: "Fuel Type" %>
                </div>
              </div>

              <div class="card-footer">
                <%= f.submit "Submit", class: "btn btn-primary" %>
              </div>

            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
